{
  "name": "dsh-bundle-apply-updates",
  "version": "0.1.2",
  "private": true,
  "description": "Apply installed DSH plugin updates through a supervised, idle-only host restart.",
  "displayName": "应用插件更新",
  "type": "module",
  "main": "./index.js",
  "exports": { ".": "./index.js", "./client": "./client.js" },
  "engines": { "node": ">=22.19.0" },
  "repository": { "type": "git", "url": "git+https://github.com/compilink/dsh-apply-updates-plugin.git" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-settings"] } },
  "files": ["index.js", "client.js", "cordis.patch.yml", "README.md"],
  "scripts": { "test": "node --test" }
}
